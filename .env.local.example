# Supabase
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Claude API
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key

# SyncFusion License
VITE_SYNCFUSION_LICENSE_KEY=your_syncfusion_license_key

# Speechmatics STT
VITE_SPEECHMATICS_API_KEY=your_speechmatics_api_key

# Azure Speech (TTS)
VITE_AZURE_SPEECH_KEY=your_azure_speech_key
VITE_AZURE_SPEECH_REGION=swedencentral

# Trafiklab (ResRobot - Kollektivtrafik)
VITE_TRAFIKLAB_API_KEY=your_trafiklab_api_key

# Trafikverket (Vägtrafikinfo)
VITE_TRAFIKVERKET_API_KEY=your_trafikverket_api_key

# Google Places (Restauranger, butiker)
VITE_GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Backend URL
VITE_BACKEND_URL=https://prio-backend.onrender.com

# Upstash Redis (Conversation persistence)
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Microsoft Azure AD (MS Graph - Calendar & Mail)
VITE_MS_CLIENT_ID=your_microsoft_client_id
VITE_MS_TENANT_ID=your_microsoft_tenant_id
VITE_MS_AUTHORITY=https://login.microsoftonline.com/your_tenant_id
